# ==========================================
# InternIQ Server - Environment Configuration
# ==========================================

# --- Core Server ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Database & Redis ---
MONGODB_URI=mongodb://localhost:27017/interniq
REDIS_URL=redis://localhost:6379

# --- Authentication (JWT) ---
# Generate secure random strings for these (e.g., using `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# --- AI & LLM Integration ---
# Default to GROQ for fast, free inference, OpenAI, or a local Llama Stack server
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
LLAMA_STACK_URL=http://localhost:8000
LLM_PROVIDER=llama-stack
LLM_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct

# --- Vector Database (Pinecone) ---
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=interniq-index
VECTOR_PROVIDER=pinecone

# --- Email (Nodemailer via Gmail) ---
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME="InternIQ Platform"

# --- Rate Limiting ---
GLOBAL_RATE_LIMIT=500
GLOBAL_RATE_WINDOW_MS=900000 # 15 minutes
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=900000 # 15 minutes
